# Copier en .env et remplacer chaque valeur. Ne jamais versionner .env.
DJANGO_SECRET_KEY=a-generer-avec-python-secrets-token-urlsafe-50
DJANGO_ALLOWED_HOSTS=localhost,optilink.local
DJANGO_CSRF_TRUSTED_ORIGINS=https://optilink.local

DB_HOST=postgres
DB_PORT=5432
DB_NAME=optilink
DB_USER=optilink
DB_PASSWORD=changez-moi
# Qualification seulement (PostgreSQL sur le même serveur) : mot de passe du super-utilisateur
# postgres, différent de DB_PASSWORD, pour l'administration et les sauvegardes.
POSTGRES_ADMIN_PASSWORD=changez-moi-aussi
# Production : verify-full (certificat du serveur vérifié). Le développement local force disable.
DB_SSLMODE=require
# DB_SSLROOTCERT=/certs/postgresql-ca.crt

REDIS_PASSWORD=changez-moi

# Chiffrement des ordonnances : générer avec
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À sauvegarder hors du serveur : sans elle, les ordonnances sont illisibles. Pour changer de
# clé, mettre la nouvelle en premier et garder l'ancienne derrière (séparées par une virgule).
PRESCRIPTIONS_CLES=a-generer

# Durée de validité par défaut d'un devis, en jours
DEVIS_VALIDITE_JOURS=30

# Sécurité (valeurs par défaut conseillées)
MFA_OBLIGATOIRE=1
COMPTES_INACTIFS_JOURS=90
SESSION_DUREE_SECONDES=36000
